# Environment and secrets
.env
.env.*
!.env.example

# Local data and caches
data/*
# data/llm_cache/ ships empty (a .gitkeep), so a clone owns it and Docker never creates the
# api container's bind-mount source as root; its cache entries stay ignored.
!data/llm_cache/
data/llm_cache/*
!data/llm_cache/.gitkeep
__pycache__/
# Local-first search/graph indexes (zvec-grep, graphify): machine-local and regenerable
.zvec-grep/
graphify-out/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
.envrc

# Docker/local artifacts
*.log
.DS_Store

# Local execution records: reports, review packages, scratch, screenshots, compat-venv
.execution/

# Frontend artifacts
web/node_modules/
web/.next/
web/out/
web/coverage/
web/playwright-report/
web/test-results/
web/*.tsbuildinfo
