FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY api/ ./api/
COPY cypher/ ./cypher/
# The webhook's REPLAY_OF allowlist reads the tenant repos through ingest.replay's loader.
COPY ingest/__init__.py ingest/replay.py ./ingest/
COPY ingest/tenants/ ./ingest/tenants/

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
