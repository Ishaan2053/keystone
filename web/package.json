{
  "name": "keystone-web",
  "version": "0.0.0",
  "private": true,
  "description": "Keystone fixture triage web shell (B3)",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test:empty": "node tests/run-empty.cjs",
    "test": "npm run test:empty && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --config playwright.api.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "driver.js": "1.10.1",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-force-graph-2d": "1.29.2",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
