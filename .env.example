FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Read-only GitHub token used for source reads.
GITHUB_TOKEN=
# Sandbox-only write token; never used for upstream reads.
GITHUB_WRITE_TOKEN=
# Strict owner/name sandbox target required for any write.
SANDBOX_REPO=
# Deployment default for live apply; public route stays dry-run only even when false is passed by browser.
DRY_RUN=true
# Canonical public origin used to build run links in posted comments.
PUBLIC_BASE_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_CACHE=on
GITHUB_WEBHOOK_SECRET=
KEYSTONE_BOT_LOGIN=
PUBLIC_BASE_URL=
TENANTS=falkordb
API_DOMAIN=
CORS_ORIGINS=http://localhost:3001
API_MODE=fixtures
# Frontend data source: `fixtures` (default) or `api`. Any other value is an error.
NEXT_PUBLIC_DATA_SOURCE=fixtures
# Origin of the live graph API when NEXT_PUBLIC_DATA_SOURCE=api (a location, not a mode flag).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
