# Host-run ingest and `API_MODE=live uvicorn` reach FalkorDB on localhost; Compose sets falkordb for the api container itself.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Read-only GitHub token used for source reads.
GITHUB_TOKEN=
# Sandbox-only write token; never used for upstream reads.
GITHUB_WRITE_TOKEN=
# Strict owner/name sandbox target required for any write.
SANDBOX_REPO=
# Parsed but not read by any path: the public apply route is always dry-run and the
# webhook flow always applies live. The public route refuses live writes with 403.
DRY_RUN=true
# Canonical public origin used to build run links in posted comments.
PUBLIC_BASE_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_CACHE=on
GITHUB_WEBHOOK_SECRET=
KEYSTONE_BOT_LOGIN=
TENANTS=falkordb
# Optional second tenant (B9): set TENANTS=falkordb,pallets to enable both.
API_DOMAIN=
# B10 hosted MCP: comma-separated slugs served publicly over HTTP at /mcp.
# Must be a subset of TENANTS; blank (the default) serves every tenant in TENANTS.
# Only the six read-only graph tools are exposed there; never apply_triage.
# Hosted MCP is live-mode only (API_MODE=live); fixture mode serves no transport.
PUBLIC_MCP_TENANTS=
CORS_ORIGINS=http://localhost:3001
API_MODE=fixtures
# Frontend data source: `fixtures` (default) or `api`. Any other value is an error.
NEXT_PUBLIC_DATA_SOURCE=fixtures
# Origin of the live graph API when NEXT_PUBLIC_DATA_SOURCE=api (a location, not a mode flag).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
